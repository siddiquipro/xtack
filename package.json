{
	"name": "xtack",
	"type": "module",
	"version": "1.2.6",
	"packageManager": "pnpm@9.0.0",
	"description": "A Node.js framework agnostic packages",
	"author": {
		"name": "Mohammad Siddiqui",
		"email": "24387047+siddiquipro@users.noreply.github.com",
		"url": "https://github.com/siddiquipro"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/siddiquipro/xtack.git"
	},
	"keywords": [
		"xtack",
		"node",
		"framework",
		"agnostic"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./session": {
			"types": "./dist/session/index.d.ts",
			"import": "./dist/session/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"import": "./dist/auth/index.js"
		},
		"./shield": {
			"types": "./dist/shield/index.d.ts",
			"import": "./dist/shield/index.js"
		},
		"./hbs": {
			"types": "./dist/hbs/index.d.ts",
			"import": "./dist/hbs/index.js"
		},
		"./assets": {
			"types": "./dist/assets/index.d.ts",
			"import": "./dist/assets/index.js"
		},
		"./helpers": {
			"types": "./dist/helpers/index.d.ts",
			"import": "./dist/helpers/index.js"
		}
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"LICENSE",
		"README.md",
		"dist"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"test": "vitest run",
		"build": "vite build",
		"deploy": "npm publish",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"handlebars": "^4.7.8"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.0.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^22.14.0",
		"eslint": "^9.39.2",
		"eslint-plugin-format": "^1.3.1",
		"semantic-release": "^25.0.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.17"
	}
}
